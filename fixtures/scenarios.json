      "invocation": {
        "contractId": "urn:reference:invoice:1",
        "input": {
          "representationId": "json",
          "value": {
            "quantity": 3,
            "unitPrice": 7,
            "label": null
          }
        },
        "acceptedOutputRepresentationIds": ["rich", "text"],
        "configuration": {
          "acceptedOutputModes": ["Text/Plain; Charset=\"utf-8\""],
          "returnImmediately": false
        }
      },
      "expected": {
        "present": true,
        "value": "21",
        "representationId": "text"
      }
    },
