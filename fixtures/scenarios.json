      "id": "same-media-companions",
      "invocation": {
        "contractId": "urn:reference:invoice:1",
        "input": {
          "representationId": "json",
          "value": {
            "quantity": 3,
            "unitPrice": 7,
            "label": null
          }
        },
        "companions": [
          {
            "data": {
              "unrelated": true
            },
            "mediaType": "application/json"
          },
          {
            "text": ""
          }
        ],
        "metadata": {
          "companions": true
        }
