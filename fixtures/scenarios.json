{
  "formatVersion": 1,
  "profile": "inline-json-text",
  "extensionUri": "https://w3id.org/a2a-schema-contract/draft/0.1",
  "scenarios": [
    {
      "id": "invoice-json-discovery",
      "invocation": {
        "contractId": "urn:reference:invoice:1",
        "input": {
          "representationId": "json",
          "value": {
            "quantity": 3,
            "unitPrice": 7,
            "label": null
          }
        }
      },
      "expected": {
        "present": true,
        "value": {
          "total": 21,
          "label": null
        },
        "representationId": "rich"
      }
    },
    {
      "id": "invoice-compact-selection",
      "invocation": {
        "contractId": "urn:reference:invoice:1",
        "input": {
          "representationId": "json",
          "value": {
            "quantity": 3,
            "unitPrice": 7,
            "label": null
          }
        },
        "acceptedOutputRepresentationIds": ["compact"]
      },
      "expected": {
        "present": true,
        "value": {
          "total": 21
        },
        "representationId": "compact"
      }
    },
