{
  "name": "a2a-schema-contract-reference",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "Independent installed-artifact A2A Schema Contract reference applications",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.23.3 || ^24.21.0"
  },
  "scripts": {
    "artifact:install": "node scripts/install-artifact.mjs",
    "build": "tsc -p tsconfig.json",
    "format": "prettier --write . ../fixtures ../docs ../.github",
    "format:check": "prettier --check . ../fixtures ../docs ../.github",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test --test-reporter=spec --test-concurrency=1 test/*.test.mjs",
    "scenarios": "npm run build && node src/client/run.mjs",
    "start": "npm run build && node dist/server/main.js",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "check:clean": "node scripts/clean-check.mjs",
    "security": "npm run build && node src/client/security.mjs",
    "discovery": "npm run build && node src/client/discovery.mjs"
  },
  "dependencies": {
    "@a2a-js/sdk": "1.3.0",
    "a2a-schema-contract": "file:artifacts/sdk.tgz",
    "express": "5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.3",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  }
}
